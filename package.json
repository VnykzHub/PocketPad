{
  "name": "lanpad",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "sdk",
    "tools/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "size": "node tools/size-budget/dist/cli.js",
    "trace": "node tools/trace-check/dist/cli.js --stage D0",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run size && npm run trace"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
