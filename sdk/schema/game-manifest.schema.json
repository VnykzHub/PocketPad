{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "lanpad Game Manifest",
  "description": "The contract between a game folder and the lanpad host. Mirrors GameManifest in sdk/src/manifest.ts.",
  "$comment": "Cross-field rules that JSON Schema cannot express are enforced by validateManifest: assetBudget.initialBytes <= assetBudget.totalBytes and minPlayers <= maxPlayers.",
  "type": "object",
  "required": [
    "name",
    "entry",
    "layouts",
    "assetBudget",
    "minPlayers",
    "maxPlayers",
    "needsGyro"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "Manifest format version. Absent means 1."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "maxLength": 140,
      "description": "Optional one-line launcher copy. Display only."
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
      "description": "Relative path to the game's entry module. No absolute paths and no '..' segments."
    },
    "layouts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$",
        "description": "Relative path to a layout JSON file. No absolute paths and no '..' segments."
      }
    },
    "assetBudget": {
      "type": "object",
      "required": ["initialBytes", "totalBytes"],
      "properties": {
        "initialBytes": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "totalBytes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "description": "Byte budgets for the first download and for all assets. initialBytes must be <= totalBytes (checked by validateManifest)."
    },
    "minPlayers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "maxPlayers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "Must be >= minPlayers (checked by validateManifest)."
    },
    "needsGyro": {
      "type": "boolean"
    },
    "chunkConfig": {
      "type": "object",
      "required": ["chunkSize", "loadRadius", "unloadRadius", "lodTiers"],
      "properties": {
        "chunkSize": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loadRadius": {
          "type": "number",
          "minimum": 0
        },
        "unloadRadius": {
          "type": "number",
          "minimum": 0
        },
        "lodTiers": {
          "type": "array",
          "minItems": 3,
          "items": {
            "type": "number"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
