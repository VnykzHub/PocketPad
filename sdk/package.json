{
  "name": "@lanpad/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run --root .. --project sdk",
    "typecheck": "tsc -p tsconfig.test.json"
  },
  "dependencies": {}
}
