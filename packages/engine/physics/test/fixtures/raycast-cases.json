        "hit": true,
        "collider": "sphere-collider",
        "triangleIndex": -1,
        "sensor": false,
        "orderedHits": null,
        "distanceMeters": null,
        "note": "Layer/mask filtering is applied before narrowphase (07 §5.5)."
      }
    },
    {
      "id": "inside-solid-reports-zero-distance",
      "description": "A solid ray starting inside the floor box returns distance 0.",
      "query": "raycast",
      "origin": [5, 0.25, 5],
      "direction": [0, 1, 0],
      "maxDistance": 5,
      "solid": true,
      "filter": null,
      "expect": {
        "hit": true,
        "collider": "floor-collider",
        "triangleIndex": -1,
        "sensor": false,
        "orderedHits": null,
        "distanceMeters": 0,
        "note": "07 §3.4: a ray starting inside a shape reports distance 0 when solid is true."
