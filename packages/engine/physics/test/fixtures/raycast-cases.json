        "hit": true,
        "collider": "sensor-collider",
        "triangleIndex": -1,
        "sensor": true,
        "orderedHits": null,
        "distanceMeters": null,
        "note": "The sensor is nearer along the ray."
      }
    },
    {
      "id": "layer-mask-excludes-sphere",
      "description": "A mask that excludes sphere layer 1 misses the sphere.",
      "query": "raycast",
      "origin": [-1, 1, 0],
      "direction": [1, 0, 0],
      "maxDistance": 10,
      "solid": true,
      "filter": { "layer": 0, "mask": 4, "includeSensors": false },
      "expect": {
        "hit": false,
        "collider": null,
        "triangleIndex": null,
        "sensor": null,
        "orderedHits": null,
        "distanceMeters": null,
        "note": "Mask bit 2 accepts only the overhead trimesh layer; the ray does not reach it."
