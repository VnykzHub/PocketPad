      "maxDistance": 10,
      "solid": true,
      "filter": null,
      "expect": {
        "hit": true,
        "collider": "floor-collider",
        "triangleIndex": -1,
        "sensor": false,
        "orderedHits": null,
        "distanceMeters": null,
        "note": "Primitive hits report triangleIndex -1 (07 §3.4)."
      }
    },
    {
      "id": "ray-up-misses",
      "description": "An upward ray from the same origin hits nothing in range.",
      "query": "raycast",
      "origin": [5, 5, 5],
      "direction": [0, 1, 0],
      "maxDistance": 10,
