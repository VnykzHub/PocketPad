        "position": [0, 0, 0],
        "enabled": true,
        "colliders": [
          {
            "id": "floor-collider",
            "shape": { "kind": "box", "halfExtents": [10, 0.5, 10] },
            "friction": 0.6,
            "restitution": 0,
            "sensor": false,
            "layer": 0,
            "mask": 4294967295
          }
        ]
      },
      {
        "id": "sphere",
        "type": "static",
        "position": [3, 1, 0],
        "enabled": true,
        "colliders": [
          {
            "id": "sphere-collider",
