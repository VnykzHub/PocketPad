      "maxDistance": 10,
      "solid": true,
      "filter": null,
      "expect": {
        "hit": true,
        "collider": "sphere-collider",
        "triangleIndex": -1,
        "sensor": false,
        "orderedHits": null,
        "distanceMeters": null,
        "note": "includeSensors defaults to false (07 §3.4)."
