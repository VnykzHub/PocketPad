{
  "$fixture": {
    "name": "raycast-cases",
    "kind": "physics-query-contract-cases",
    "formatVersion": 1,
    "spec": "docs/engine/07-physics3d.md",
    "sections": ["3.4", "5.5"],
    "synthetic": true,
    "measured": false,
    "dateFormat": "none",
    "notes": [
      "Synthetic geometry and expected topology only. No engine run produced these values.",
      "Vec3 uses [x, y, z] in metres. Quat uses [x, y, z, w]. Trimesh vertices are world-local; indices are triangles.",
      "distanceMeters is omitted for ordinary hits because no engine exists to measure it. The one explicit 0 is the contract rule for a solid ray starting inside a shape (07 §3.4).",
      "hit and orderedHits are topology: nearest collider, sensor flag and triangle index. Normals, points and travel are not asserted."
    ]
  },
  "fixtureVersion": 1,
  "world": {
    "gravity": [0, -9.81, 0],
