            {
              "offset": 12,
              "shaderLocation": 1,
              "name": "normal",
              "format": "float32x3"
            },
            {
              "offset": 24,
              "shaderLocation": 2,
              "name": "uv",
              "format": "float32x2"
            }
          ]
        }
      ]
    },
    "instanced-transform-v1": {
      "label": "instanced-transform-v1",
      "topology": "triangle-list",
      "buffers": [
        {
          "slot": 0,
          "stepMode": "vertex",
          "stride": 32,
          "attributes": [
            {
              "offset": 0,
              "shaderLocation": 0,
              "name": "position",
              "format": "float32x3"
            },
            {
              "offset": 12,
              "shaderLocation": 1,
