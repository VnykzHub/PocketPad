              "offset": 32,
              "shaderLocation": 5,
              "name": "model2",
              "format": "float32x4"
            },
            {
              "offset": 48,
              "shaderLocation": 6,
              "name": "model3",
              "format": "float32x4"
            }
          ]
        }
      ]
    }
